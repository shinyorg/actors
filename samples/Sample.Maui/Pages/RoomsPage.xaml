<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Sample.Maui.Pages.RoomsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:actors="clr-namespace:Sample.Maui.Actors"
    Title="Rooms">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Label x:Name="TargetLabel" AutomationId="ConnectedTo" FontSize="13" TextColor="{AppThemeBinding Light=#6e6e73, Dark=#a1a1a6}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="NewRoom" AutomationId="NewRoomEntry" Placeholder="New room name" ReturnType="Go" Completed="OnCreate" />
            <Button Grid.Column="1" AutomationId="CreateRoom" Text="Create" Clicked="OnCreate" />
        </Grid>

        <CollectionView x:Name="RoomList" Grid.Row="2" AutomationId="RoomList" SelectionMode="Single" SelectionChanged="OnSelected">
            <CollectionView.EmptyView>
                <Label Text="No rooms yet." Padding="0,12" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="actors:RoomSummary">
                    <VerticalStackLayout Padding="0,10" Spacing="2">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                        <Label Text="{Binding LastMessage, TargetNullValue='No messages yet'}" FontSize="14" LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light=#6e6e73, Dark=#a1a1a6}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
