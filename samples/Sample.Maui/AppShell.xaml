<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sample.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Sample.Maui.Pages"
    Title="Shiny Chat">

    <TabBar>
        <ShellContent Title="Rooms" Route="rooms" ContentTemplate="{DataTemplate pages:RoomsPage}" />
        <ShellContent Title="Nearby" Route="nearby" ContentTemplate="{DataTemplate pages:NearbyPage}" />
    </TabBar>

</Shell>
