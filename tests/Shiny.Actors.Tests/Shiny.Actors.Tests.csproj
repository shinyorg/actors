<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Shiny.DocumentDb.Sqlite" Version="14.0.0" />
    <!-- GHSA-2m69-gcr7-jv3q: Shiny.DocumentDb.Sqlite 14.0.0 pulls in 2.1.11; 2.1.12+ is patched -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shiny.Actors\Shiny.Actors.csproj" />
    <ProjectReference Include="..\..\src\Shiny.Actors.HttpServer\Shiny.Actors.HttpServer.csproj" />
    <ProjectReference Include="..\..\src\Shiny.Actors.Jobs\Shiny.Actors.Jobs.csproj" />
    <ProjectReference Include="..\..\src\Shiny.Actors.DocumentDb\Shiny.Actors.DocumentDb.csproj" />
    <ProjectReference Include="..\..\src\Shiny.Actors.Testing\Shiny.Actors.Testing.csproj" />
    <ProjectReference Include="..\..\src\Shiny.Actors.Discovery\Shiny.Actors.Discovery.csproj" />
    <ProjectReference Include="..\..\src\Shiny.Actors.Notifications\Shiny.Actors.Notifications.csproj" />
    <!-- what the NuGet package does for consumers through analyzers/dotnet/cs -->
    <ProjectReference Include="..\..\src\Shiny.Actors.SourceGenerators\Shiny.Actors.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
