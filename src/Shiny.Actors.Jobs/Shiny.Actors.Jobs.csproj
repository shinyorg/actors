<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Description>Fires Shiny.Actors reminders from a Shiny.Jobs background job, so they run when the OS wakes a backgrounded or terminated app.</Description>
    <PackageTags>actors;reminders;jobs;background;maui;shiny</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Jobs" Version="5.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shiny.Actors\Shiny.Actors.csproj" />
  </ItemGroup>

</Project>
