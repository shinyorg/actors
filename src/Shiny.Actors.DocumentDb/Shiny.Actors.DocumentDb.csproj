<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Description>Shiny.Actors state and reminders in Shiny.DocumentDb - SQLite on a device, or PostgreSQL, SQL Server, Cosmos DB, IndexedDB and the rest - with optimistic concurrency.</Description>
    <PackageTags>actors;state;persistence;documentdb;sqlite;maui;aot;shiny</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.DocumentDb" Version="14.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shiny.Actors\Shiny.Actors.csproj" />
  </ItemGroup>

</Project>
